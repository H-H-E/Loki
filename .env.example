# Server-only values. Never use a VITE_ prefix for these variables.
# Copy the pooled Postgres connection string from Neon with SSL enabled.
DATABASE_URL=
# Direct, unpooled Neon connection string for schema migrations.
# Required by db:migrate when DATABASE_URL uses Neon's -pooler hostname.
# Vercel's Neon integration supplies this variable automatically.
DATABASE_URL_UNPOOLED=

# Use a unique random value with at least 32 characters.
# Keep this value stable across deployments so existing sessions remain valid.
BETTER_AUTH_SECRET=
# Exact public application origin, without /api/auth or a trailing slash.
# Production must use HTTPS; localhost HTTP is allowed for development.
BETTER_AUTH_URL=http://localhost:4173
# In Vercel Preview, omit BETTER_AUTH_URL to derive the exact deployment URL.
# Production requires its explicit canonical HTTPS origin.

# Provider credentials remain private in Vercel Functions.
EVERYSONG_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# No frontend database credentials are needed. The browser uses same-origin
# cookie sessions and private /api routes. Local editing works without secrets.
